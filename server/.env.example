PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-secret-for-local-development
DATABASE_URL=postgresql://mathew_app:your_password_here@localhost:5432/mathew_research
# Supabase: paste the Session pooler connection string from Project > Connect.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# If port 5432 times out, the Transaction pooler URI on port 6543 is also supported.
# Supabase's public root CA is bundled in server/certs; keep certificate verification enabled.
# Optional migration template (never place a real password in this setting):
# SUPABASE_CONNECTION_TEMPLATE="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"
DATABASE_SSL=auto
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=15000
BCRYPT_ROUNDS=10
# Leave false so automated tests use the isolated JSON test store instead of your live local database.
USE_POSTGRES_IN_TESTS=false

# NLP provider: "rule" keeps the built-in extractor only. "hybrid" also calls the
# localhost Hugging Face service and falls back safely if that service is offline.
NLP_PROVIDER=rule
HF_NLP_URL=http://127.0.0.1:8001
HF_NLP_TIMEOUT_MS=12000
HF_NLP_MIN_SCORE=0.65

# Optional for emailing new staff login details. If these are empty, the server logs the email content in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediTrack NLP <no-reply@meditrack.local>"
